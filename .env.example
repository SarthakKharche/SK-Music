# Server
NODE_ENV=production
PORT=5000
CLIENT_URL=https://app.example.com
CLIENT_URLS=https://app.example.com
SESSION_SECRET=replace-with-random-secret
JWT_SECRET=replace-with-random-jwt-secret

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://api.example.com/api/auth/google/callback

# Spotify OAuth
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=https://api.example.com/api/auth/spotify/callback

# Firebase Admin
FIREBASE_PROJECT_ID=sk-music-bc6aa
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@sk-music-bc6aa.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nYOUR-FIREBASE-PRIVATE-KEY\\n-----END PRIVATE KEY-----\\n"

# Audio Resolver
AUDIO_RESOLVER_API_URL=https://your-audio-resolver-api.com
AUDIO_RESOLVER_API_KEY=your-api-key

# Client
VITE_API_URL=https://api.example.com/api
